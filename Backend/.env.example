# Server
PORT=8000
PROJECT_STATUS=development   # "development" or "production" (controls secure cookies + CORS behavior)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database-name>
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins (credentials: true)
CORS_ORIGIN=http://localhost:5173
# Absolute URL of the deployed storefront (used for Stripe redirects)
ECOMMERCE_STORE_URL=http://localhost:5173

# Cloudinary (product/shop/review image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# NOTE: variable is intentionally spelled CLOUDIANRY_API_SECRET to match the app
CLOUDIANRY_API_SECRET=

# Stripe
STRIPE_PUBLISH_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SHIPPING_RATE_STANDARD=shr_...
STRIPE_SHIPPING_RATE_EXPRESS=shr_...
SHIPPING_ALLOWED_COUNTRIES=US   # comma-separated ISO country codes

# SMTP (used to email a seller when their shop request is rejected)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=Gmail
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password